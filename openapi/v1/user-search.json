{
  "openapi": "3.1.0",
  "info": {
    "title": "Acervo User Search API",
    "version": "3.0.0",
    "description": "Admin-only contract for a typeahead-style search of active users by name or email within the authenticated admin's institution. Block B consistently enforces operational suspension and credential epochs. Old credentials without current epoch metadata require fresh login; reactivation restores no credentials."
  },
  "tags": [
    {
      "name": "User search",
      "description": "Admin-only institutional lookup of active users by partial name or email match."
    }
  ],
  "paths": {
    "/api/v1/user/search": {
      "get": {
        "operationId": "searchUsers",
        "summary": "Search active users by name or email",
        "description": "Returns up to 10 active users in the authenticated admin's institution whose name or email contains q. Users from other institutions are never observable and no institution selector is accepted. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "tags": ["User search"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Query" }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserSearchSuccess" },
                "example": {
                  "success": true,
                  "data": {
                    "users": [
                      {
                        "id": "55555555-5555-5555-5555-555555555555",
                        "name": "Ana Pérez",
                        "email": "ana.perez@example.com"
                      }
                    ]
                  },
                  "message": "Users retrieved successfully."
                }
              }
            }
          },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/LegacyError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/ForbiddenError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "parameters": {
      "Query": {
        "name": "q",
        "in": "query",
        "required": true,
        "description": "Search term matched against name and email within the authenticated admin's institution, case-insensitively, as a partial (substring) match. Must be at least 2 characters.",
        "schema": { "type": "string", "minLength": 2, "maxLength": 100 },
        "example": "ana"
      }
    },
    "schemas": {
      "UserSearchResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "email"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "Identifier of a user in the authenticated admin's institution." },
          "name": { "type": "string", "description": "Display name." },
          "email": { "type": "string", "format": "email", "description": "Unique login email." }
        }
      },
      "UserSearchData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["users"],
        "properties": {
          "users": {
            "type": "array",
            "maxItems": 10,
            "items": { "$ref": "#/components/schemas/UserSearchResult" }
          }
        }
      },
      "UserSearchSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "data", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/UserSearchData" },
          "message": { "type": "string", "enum": ["Users retrieved successfully."] }
        }
      },
      "LegacyError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string" }
        }
      },
      "ForbiddenError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "enum": ["Forbidden."] }
        }
      },
      "ValidationFailedError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "message", "data"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string", "enum": ["Validation failed."] },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["error"],
            "properties": {
              "error": {
                "type": "object",
                "description": "Laravel validator error bag: field name to list of messages.",
                "additionalProperties": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      },
      "InstitutionAccessError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "enum": [
                  "INSTITUTION_SUSPENDED",
                  "AUTH_UNAUTHENTICATED",
                  "AUTH_ACCOUNT_INACTIVE",
                  "USER_QUOTA_EXCEEDED",
                  "INSTITUTION_REQUIRES_USABLE_ADMIN"
                ]
              },
              "message": { "type": "string" },
              "details": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "limit",
                  "used",
                  "requested_delta"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "admin",
                      "editor",
                      "reader"
                    ]
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "used": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "requested_delta": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "A valid Sanctum bearer token is required.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/LegacyError" },
            "example": { "success": false, "message": "Unauthenticated." }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated user does not have institutional users.manage authority.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ForbiddenError" },
            "example": { "message": "Forbidden." }
          }
        }
      },
      "ValidationFailed": {
        "description": "Request validation failed.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationFailedError" },
            "example": {
              "success": false,
              "message": "Validation failed.",
              "data": { "error": { "q": ["The q field is required."] } }
            }
          }
        }
      }
    }
  }
}
