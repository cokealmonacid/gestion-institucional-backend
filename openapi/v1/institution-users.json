{
  "openapi": "3.1.0",
  "info": {
    "title": "Acervo Institutional Users API",
    "version": "3.0.0",
    "description": "Admin-only contract for listing users, registering accounts, previewing responsibility impact, and atomically updating profile and role data in the authenticated administrator's institution. Version 3 requires preview and explicit confirmation when a role change removes responsible eligibility."
  },
  "tags": [
    {
      "name": "Institution users",
      "description": "Institution-scoped user management restricted to admins of the target institution."
    }
  ],
  "paths": {
    "/api/v1/institution/users": {
      "get": {
        "operationId": "listInstitutionUsers",
        "summary": "List users of an institution",
        "description": "Returns all users, including the authenticated administrator, belonging to the authenticated administrator's institution. institution_id is retained for compatibility but must match that server-derived context.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/InstitutionId" },
          { "$ref": "#/components/parameters/PerPage" }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserPageSuccess" },
                "example": {
                  "success": true,
                  "data": {
                    "current_page": 1,
                    "data": [
                      {
                        "id": "55555555-5555-5555-5555-555555555555",
                        "name": "Ana Pérez",
                        "email": "ana.perez@example.com",
                        "role": "editor",
                        "created_at": "8 days ago",
                        "active": true
                      }
                    ],
                    "first_page_url": "http://localhost/api/v1/institution/users?page=1",
                    "from": 1,
                    "last_page": 1,
                    "last_page_url": "http://localhost/api/v1/institution/users?page=1",
                    "links": [
                      { "url": null, "label": "&laquo; Previous", "active": false },
                      { "url": "http://localhost/api/v1/institution/users?page=1", "label": "1", "active": true },
                      { "url": null, "label": "Next &raquo;", "active": false }
                    ],
                    "next_page_url": null,
                    "path": "http://localhost/api/v1/institution/users",
                    "per_page": 15,
                    "prev_page_url": null,
                    "to": 1,
                    "total": 1
                  },
                  "message": "Users retrieved successfully."
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "post": {
        "operationId": "registerInstitutionUser",
        "summary": "Register a user in an institution",
        "description": "Creates a user with the given role in institution_id. The caller must be an admin and institution_id must equal the authenticated admin's own institution_id.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUserRequest" },
              "example": {
                "institution_id": "22222222-2222-2222-2222-222222222222",
                "name": "Ana Pérez",
                "email": "ana.perez@example.com",
                "password": "password123",
                "password_confirmation": "password123",
                "rol": "editor"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptyDataSuccess" },
                "example": { "success": true, "data": [], "message": "Account registered successfully." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "patch": {
        "operationId": "updateInstitutionUser",
        "summary": "Update a user's profile, role, and active status",
        "description": "Updates the user identified by email. institution_id must equal both the authenticated admin's own institution_id and the target user's institution_id. When role is present, it replaces any role currently assigned to the user. When the requested role removes the last admin/editor role, a current role-impact token and explicit responsibility-removal confirmation are required, including when the impact count is zero. The role change, removal from active and inactive documents, responsibility histories, revisions, and events are one transaction. A stale impact is rejected. Account deactivation alone preserves existing responsibilities. An admin demoting themself to editor or reader requires another distinct, non-deleted admin account; inactive admin accounts count.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserRequest" },
              "example": {
                "institution_id": "22222222-2222-2222-2222-222222222222",
                "email": "ana.perez@example.com",
                "name": "Ana Pérez Soto",
                "role": "admin",
                "active": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptyDataSuccess" },
                "example": { "success": true, "data": [], "message": "Account updated successfully." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "409": { "$ref": "#/components/responses/RoleChangeConflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "delete": {
        "operationId": "deleteInstitutionUser",
        "summary": "Delete a user",
        "description": "Soft-deletes the user identified by email. institution_id must equal both the authenticated admin's own institution_id and the target user's institution_id. An admin cannot delete their own account.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeleteUserRequest" },
              "example": {
                "institution_id": "22222222-2222-2222-2222-222222222222",
                "email": "ana.perez@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User deleted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptyDataSuccess" },
                "example": { "success": true, "data": [], "message": "Account deleted successfully." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/api/v1/institution/users/role-impact": {
      "post": {
        "operationId": "inspectInstitutionUserRoleImpact",
        "summary": "Inspect responsibility impact before changing a role",
        "description": "Admin only. Evaluates the target user's actual roles. If the requested single managed role removes the last admin/editor role, returns the number of active and inactive institutional documents that would lose their responsible user and an opaque token bound to the roles and document responsibility revisions observed. This operation does not modify data.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleImpactRequest" }, "example": { "institution_id": "22222222-2222-2222-2222-222222222222", "email": "ana.perez@example.com", "role": "reader" } } }
        },
        "responses": {
          "200": { "description": "Current role impact retrieved without mutation.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleImpactSuccess" }, "example": { "success": true, "data": { "affected_documents_count": 4, "confirmation_required": true, "impact_token": "opaque-impact-token" }, "message": "Role change impact retrieved successfully." } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "parameters": {
      "InstitutionId": {
        "name": "institution_id",
        "in": "query",
        "required": true,
        "description": "Compatibility parameter. Must equal the authenticated admin's server-derived institution_id; another valid UUID is indistinguishable from an unavailable institutional target.",
        "schema": { "type": "string", "format": "uuid" },
        "example": "22222222-2222-2222-2222-222222222222"
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "required": false,
        "description": "Page size. Defaults to 15.",
        "schema": { "type": "integer", "minimum": 1 },
        "example": 15
      }
    },
    "schemas": {
      "RoleType": {
        "type": "string",
        "enum": ["admin", "editor", "reader"]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "email", "role", "created_at", "active"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "User identifier." },
          "name": { "type": "string", "description": "Display name." },
          "email": { "type": "string", "format": "email", "description": "Unique login email." },
          "role": {
            "oneOf": [
              { "$ref": "#/components/schemas/RoleType" },
              { "type": "null" }
            ],
            "description": "The user's role type, or null if no role is assigned."
          },
          "created_at": { "type": "string", "description": "Human-readable relative time since account creation (e.g. \"8 days ago\")." },
          "active": { "type": "boolean", "description": "Whether the user may sign in to the platform." }
        }
      },
      "PaginationLink": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "label", "active"],
        "properties": {
          "url": { "type": ["string", "null"] },
          "label": { "type": "string" },
          "active": { "type": "boolean" }
        }
      },
      "UserPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current_page", "data", "first_page_url", "from", "last_page", "last_page_url",
          "links", "next_page_url", "path", "per_page", "prev_page_url", "to", "total"
        ],
        "properties": {
          "current_page": { "type": "integer" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/User" } },
          "first_page_url": { "type": ["string", "null"] },
          "from": { "type": ["integer", "null"] },
          "last_page": { "type": "integer" },
          "last_page_url": { "type": ["string", "null"] },
          "links": { "type": "array", "items": { "$ref": "#/components/schemas/PaginationLink" } },
          "next_page_url": { "type": ["string", "null"] },
          "path": { "type": "string" },
          "per_page": { "type": "integer" },
          "prev_page_url": { "type": ["string", "null"] },
          "to": { "type": ["integer", "null"] },
          "total": { "type": "integer" }
        }
      },
      "UserPageSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "data", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/UserPage" },
          "message": { "type": "string", "enum": ["Users retrieved successfully."] }
        }
      },
      "EmptyDataSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "data", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "type": "array", "maxItems": 0 },
          "message": {
            "type": "string",
            "enum": [
              "Account registered successfully.",
              "Account updated successfully.",
              "Account deleted successfully."
            ]
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution_id", "name", "email", "password", "password_confirmation", "rol"],
        "properties": {
          "institution_id": { "type": "string", "format": "uuid", "description": "Must equal the authenticated admin's own institution_id." },
          "name": { "type": "string", "maxLength": 255 },
          "email": { "type": "string", "format": "email", "description": "Must not already exist in users.email." },
          "password": { "type": "string", "minLength": 8 },
          "password_confirmation": { "type": "string", "description": "Must equal password." },
          "rol": { "$ref": "#/components/schemas/RoleType" }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution_id", "email"],
        "properties": {
          "institution_id": { "type": "string", "format": "uuid", "description": "Must equal the authenticated admin's own institution_id and the target user's institution_id." },
          "email": { "type": "string", "format": "email", "description": "Identifies a user in the authenticated admin's institution. Foreign and nonexistent emails are indistinguishable." },
          "name": { "type": "string", "maxLength": 255 },
          "role": { "$ref": "#/components/schemas/RoleType" },
          "active": { "type": "boolean", "description": "Whether the user may sign in to the platform. Changing only this field does not remove existing responsibilities." },
          "role_impact_token": { "type": "string", "maxLength": 255, "description": "Opaque token from the latest matching role-impact response. Required when confirmation_required was true." },
          "confirm_responsibility_removal": { "type": "boolean", "enum": [true], "description": "Explicit confirmation required with role_impact_token when the role change removes the last admin/editor role." }
        }
      },
      "RoleImpactRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution_id", "email", "role"],
        "properties": {
          "institution_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "role": { "$ref": "#/components/schemas/RoleType" }
        }
      },
      "RoleImpactData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["affected_documents_count", "confirmation_required", "impact_token"],
        "properties": {
          "affected_documents_count": { "type": "integer", "minimum": 0 },
          "confirmation_required": { "type": "boolean" },
          "impact_token": { "type": ["string", "null"], "description": "Opaque state-bound token; null when no confirmation is required." }
        }
      },
      "RoleImpactSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "data", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/RoleImpactData" },
          "message": { "type": "string", "enum": ["Role change impact retrieved successfully."] }
        }
      },
      "DeleteUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution_id", "email"],
        "properties": {
          "institution_id": { "type": "string", "format": "uuid", "description": "Must equal the authenticated admin's own institution_id and the target user's institution_id." },
          "email": { "type": "string", "format": "email", "description": "Identifies a user in the authenticated admin's institution and must not identify the authenticated admin. Foreign and nonexistent emails are indistinguishable." }
        }
      },
      "LegacyError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string" }
        }
      },
      "ForbiddenError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "enum": ["Forbidden."] }
        }
      },
      "AnotherAdministratorRequiredError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "message", "code"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string", "enum": ["The institution must retain another administrator."] },
          "code": { "type": "string", "enum": ["INSTITUTION_REQUIRES_ANOTHER_ADMIN"] }
        }
      },
      "RoleChangeImpactError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "message", "code"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string" },
          "code": { "type": "string", "enum": ["ROLE_CHANGE_IMPACT_CONFIRMATION_REQUIRED", "ROLE_CHANGE_IMPACT_STALE"] }
        }
      },
      "ValidationFailedError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "message", "data"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string", "enum": ["Validation failed."] },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["error"],
            "properties": {
              "error": {
                "type": "object",
                "description": "Laravel validator error bag: field name to list of messages.",
                "additionalProperties": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "A valid Sanctum bearer token is required.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/LegacyError" },
            "example": { "success": false, "message": "Unauthenticated." }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated user does not have users.manage.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ForbiddenError" },
            "example": { "message": "Forbidden." }
          }
        }
      },
      "InstitutionUserNotFound": {
        "description": "The supplied institutional context or target user is unavailable. Foreign and nonexistent targets are indistinguishable.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/LegacyError" },
            "example": { "success": false, "message": "Institution user not found." }
          }
        }
      },
      "AnotherAdministratorRequired": {
        "description": "An admin cannot demote themself because no other non-deleted admin account belongs to the institution. Inactive admin accounts count.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/AnotherAdministratorRequiredError" },
            "example": {
              "success": false,
              "message": "The institution must retain another administrator.",
              "code": "INSTITUTION_REQUIRES_ANOTHER_ADMIN"
            }
          }
        }
      },
      "RoleChangeConflict": {
        "description": "The self-demotion would leave no other administrator, explicit impact confirmation is missing, or the reviewed impact is stale. No update is applied.",
        "content": {
          "application/json": {
            "schema": { "oneOf": [
              { "$ref": "#/components/schemas/AnotherAdministratorRequiredError" },
              { "$ref": "#/components/schemas/RoleChangeImpactError" }
            ] },
            "examples": {
              "confirmationRequired": { "value": { "success": false, "message": "Review and confirm the responsibility impact before changing this role.", "code": "ROLE_CHANGE_IMPACT_CONFIRMATION_REQUIRED" } },
              "stale": { "value": { "success": false, "message": "The responsibility impact has changed. Review it again before confirming.", "code": "ROLE_CHANGE_IMPACT_STALE" } }
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "Request validation failed.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationFailedError" },
            "example": {
              "success": false,
              "message": "Validation failed.",
              "data": { "error": { "email": ["The email field is required."] } }
            }
          }
        }
      }
    }
  }
}
