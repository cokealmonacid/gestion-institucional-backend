{
  "openapi": "3.1.0",
  "info": {
    "title": "Acervo Institutional Users API",
    "version": "4.0.0",
    "description": "Admin-only contract for institutional users. Version 3.1 adds invitation-based account creation plus separate invitation status and resend operations while preserving the existing password-based POST /institution/users and its closed responses during frontend transition. Block B consistently enforces operational suspension and credential epochs. Old credentials without current epoch metadata require fresh login; reactivation restores no credentials. Quotas count each actual role of active non-deleted users, including pending/expired invitations. Only positive over-limit occupancy changes are rejected. Usable admin requires active, verified and nonempty password. Explicit role replacement retains impact confirmation; other edits preserve multiple roles. Legacy password POST remains supported."
  },
  "tags": [
    {
      "name": "Institution users",
      "description": "Institution-scoped user management restricted to admins of the target institution."
    }
  ],
  "paths": {
    "/api/v1/institution/users": {
      "get": {
        "operationId": "listInstitutionUsers",
        "summary": "List users of an institution",
        "description": "Returns all users, including the authenticated administrator, belonging to the authenticated administrator's institution. institution_id is retained for compatibility but must match that server-derived context. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/InstitutionId" },
          { "$ref": "#/components/parameters/PerPage" }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserPageSuccess" },
                "example": {
                  "success": true,
                  "data": {
                    "current_page": 1,
                    "data": [
                      {
                        "id": "55555555-5555-5555-5555-555555555555",
                        "name": "Ana Pérez",
                        "email": "ana.perez@example.com",
                        "role": "editor",
                        "created_at": "8 days ago",
                        "active": true
                      }
                    ],
                    "first_page_url": "http://localhost/api/v1/institution/users?page=1",
                    "from": 1,
                    "last_page": 1,
                    "last_page_url": "http://localhost/api/v1/institution/users?page=1",
                    "links": [
                      { "url": null, "label": "&laquo; Previous", "active": false },
                      { "url": "http://localhost/api/v1/institution/users?page=1", "label": "1", "active": true },
                      { "url": null, "label": "Next &raquo;", "active": false }
                    ],
                    "next_page_url": null,
                    "path": "http://localhost/api/v1/institution/users",
                    "per_page": 15,
                    "prev_page_url": null,
                    "to": 1,
                    "total": 1
                  },
                  "message": "Users retrieved successfully."
                }
              }
            }
          },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/LegacyError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/ForbiddenError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "post": {
        "operationId": "registerInstitutionUser",
        "summary": "Register a user in an institution",
        "description": "Creates a user with the given role in institution_id. The caller must be an admin and institution_id must equal the authenticated admin's own institution_id. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUserRequest" },
              "example": {
                "institution_id": "22222222-2222-2222-2222-222222222222",
                "name": "Ana Pérez",
                "email": "ana.perez@example.com",
                "password": "password123",
                "password_confirmation": "password123",
                "rol": "editor"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptyDataSuccess" },
                "example": { "success": true, "data": [], "message": "Account registered successfully." }
              }
            }
          },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/LegacyError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/ForbiddenError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "409": {
            "description": "Quota or last usable administrator removal denied atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstitutionAccessError"
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "patch": {
        "operationId": "updateInstitutionUser",
        "summary": "Update a user's profile, role, and active status",
        "description": "Updates the user identified by email. institution_id must equal both the authenticated admin's own institution_id and the target user's institution_id. When role is present, it replaces any role currently assigned to the user. When the requested role removes the last admin/editor role, a current role-impact token and explicit responsibility-removal confirmation are required, including when the impact count is zero. The role change, removal from active and inactive documents, responsibility histories, revisions, and events are one transaction. A stale impact is rejected. Account deactivation alone preserves existing responsibilities. Deletion, deactivation and explicit role replacement cannot remove the last active, verified administrator with a nonempty password, regardless of actor or target. Pending/inactive/deleted administrators do not satisfy this invariant. Existing zero-usable-admin states and pending initial administrators remain repairable. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserRequest" },
              "example": {
                "institution_id": "22222222-2222-2222-2222-222222222222",
                "email": "ana.perez@example.com",
                "name": "Ana Pérez Soto",
                "role": "admin",
                "active": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptyDataSuccess" },
                "example": { "success": true, "data": [], "message": "Account updated successfully." }
              }
            }
          },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/LegacyError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/ForbiddenError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "409": {
            "description": "Quota or last usable administrator removal denied atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    },
                    { "$ref": "#/components/schemas/RoleChangeImpactError" }
                  ]
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "delete": {
        "operationId": "deleteInstitutionUser",
        "summary": "Delete a user",
        "description": "Soft-deletes the user identified by email. institution_id must equal both the authenticated admin's own institution_id and the target user's institution_id. An admin cannot delete their own account. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeleteUserRequest" },
              "example": {
                "institution_id": "22222222-2222-2222-2222-222222222222",
                "email": "ana.perez@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User deleted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptyDataSuccess" },
                "example": { "success": true, "data": [], "message": "Account deleted successfully." }
              }
            }
          },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/LegacyError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/ForbiddenError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "409": {
            "description": "Quota or last usable administrator removal denied atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstitutionAccessError"
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/api/v1/institution/user-invitations": {
      "post": {
        "operationId": "inviteInstitutionUser",
        "summary": "Create an institutional user and invitation atomically",
        "description": "Admin only. Creates a pending account, assigns one role, and creates a 48-hour single-use invitation. The administrator never supplies or learns the password. A queue publication failure still returns 201 with delivery_status failed because the account exists and can be located and resent. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InviteUserRequest" } } } },
        "responses": {
          "201": { "description": "Account and invitation created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvitationMutationSuccess" } } } },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/LegacyError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/ForbiddenError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "409": { "description": "The authenticated institution is inactive.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanonicalError" } } } },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "description": "The account transaction failed; no account was created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanonicalError" } } } }
        }
      }
    },
    "/api/v1/institution/users/{user_id}/invitation": {
      "parameters": [{ "$ref": "#/components/parameters/UserId" }],
      "get": {
        "operationId": "getInstitutionUserInvitationStatus",
        "summary": "Read activation and invitation-delivery state without changing the closed user list resource",
        "description": "Transition endpoint for the new frontend. Existing GET /institution/users rows remain unchanged until the coordinated major contract release. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Current activation and invitation status.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvitationStatusSuccess" } } } },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/LegacyError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/ForbiddenError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" }
        }
      },
      "post": {
        "operationId": "resendInstitutionUserInvitation",
        "summary": "Replace and resend a pending invitation",
        "description": "Admin only. Replaces the current token, invalidates older links, and queues a new encrypted mail job. The minimum resend interval is 60 seconds. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "202": { "description": "New invitation created; delivery_status reports queue publication outcome.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvitationMutationSuccess" } } } },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/LegacyError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/ForbiddenError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "409": { "description": "The account is not eligible for invitation.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanonicalError" } } } },
          "429": { "description": "The resend interval has not elapsed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanonicalError" } } } }
        }
      }
    },
    "/api/v1/institution/users/role-impact": {
      "post": {
        "operationId": "inspectInstitutionUserRoleImpact",
        "summary": "Inspect responsibility impact before changing a role",
        "description": "Admin only. Evaluates the target user's actual roles. If the requested single managed role removes the last admin/editor role, returns the number of active and inactive institutional documents that would lose their responsible user and an opaque token bound to the roles and document responsibility revisions observed. This operation does not modify data. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "tags": ["Institution users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleImpactRequest" }, "example": { "institution_id": "22222222-2222-2222-2222-222222222222", "email": "ana.perez@example.com", "role": "reader" } } }
        },
        "responses": {
          "200": { "description": "Current role impact retrieved without mutation.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleImpactSuccess" }, "example": { "success": true, "data": { "affected_documents_count": 4, "confirmation_required": true, "impact_token": "opaque-impact-token" }, "message": "Role change impact retrieved successfully." } } } },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/LegacyError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/ForbiddenError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/InstitutionUserNotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "parameters": {
      "InstitutionId": {
        "name": "institution_id",
        "in": "query",
        "required": true,
        "description": "Compatibility parameter. Must equal the authenticated admin's server-derived institution_id; another valid UUID is indistinguishable from an unavailable institutional target.",
        "schema": { "type": "string", "format": "uuid" },
        "example": "22222222-2222-2222-2222-222222222222"
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "required": false,
        "description": "Page size. Defaults to 15.",
        "schema": { "type": "integer", "minimum": 1 },
        "example": 15
      },
      "UserId": { "name": "user_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "schemas": {
      "RoleType": { "type": "string", "enum": ["admin", "editor", "reader"] },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "email", "role", "created_at", "active"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "User identifier." },
          "name": { "type": "string", "description": "Display name." },
          "email": { "type": "string", "format": "email", "description": "Unique login email." },
          "role": {
            "oneOf": [
              { "$ref": "#/components/schemas/RoleType" },
              { "type": "null" }
            ],
            "description": "The user's role type, or null if no role is assigned."
          },
          "created_at": { "type": "string", "description": "Human-readable relative time since account creation (e.g. \"8 days ago\")." },
          "active": { "type": "boolean", "description": "Whether the user may sign in to the platform." }
        }
      },
      "PaginationLink": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "label", "active"],
        "properties": {
          "url": { "type": ["string", "null"] },
          "label": { "type": "string" },
          "active": { "type": "boolean" }
        }
      },
      "UserPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current_page", "data", "first_page_url", "from", "last_page", "last_page_url",
          "links", "next_page_url", "path", "per_page", "prev_page_url", "to", "total"
        ],
        "properties": {
          "current_page": { "type": "integer" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/User" } },
          "first_page_url": { "type": ["string", "null"] },
          "from": { "type": ["integer", "null"] },
          "last_page": { "type": "integer" },
          "last_page_url": { "type": ["string", "null"] },
          "links": { "type": "array", "items": { "$ref": "#/components/schemas/PaginationLink" } },
          "next_page_url": { "type": ["string", "null"] },
          "path": { "type": "string" },
          "per_page": { "type": "integer" },
          "prev_page_url": { "type": ["string", "null"] },
          "to": { "type": ["integer", "null"] },
          "total": { "type": "integer" }
        }
      },
      "UserPageSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "data", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/UserPage" },
          "message": { "type": "string", "enum": ["Users retrieved successfully."] }
        }
      },
      "EmptyDataSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "data", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "type": "array", "maxItems": 0 },
          "message": {
            "type": "string",
            "enum": [
              "Account registered successfully.",
              "Account updated successfully.",
              "Account deleted successfully."
            ]
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution_id", "name", "email", "password", "password_confirmation", "rol"],
        "properties": {
          "institution_id": { "type": "string", "format": "uuid", "description": "Must equal the authenticated admin's own institution_id." },
          "name": { "type": "string", "maxLength": 255 },
          "email": { "type": "string", "format": "email", "description": "Must not already exist in users.email." },
          "password": { "type": "string", "minLength": 8 },
          "password_confirmation": { "type": "string", "description": "Must equal password." },
          "rol": { "$ref": "#/components/schemas/RoleType" }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution_id", "email"],
        "properties": {
          "institution_id": { "type": "string", "format": "uuid", "description": "Must equal the authenticated admin's own institution_id and the target user's institution_id." },
          "email": { "type": "string", "format": "email", "description": "Identifies a user in the authenticated admin's institution. Foreign and nonexistent emails are indistinguishable." },
          "name": { "type": "string", "maxLength": 255 },
          "role": { "$ref": "#/components/schemas/RoleType" },
          "active": { "type": "boolean", "description": "Whether the user may sign in to the platform. Changing only this field does not remove existing responsibilities." },
          "role_impact_token": { "type": "string", "maxLength": 255, "description": "Opaque token from the latest matching role-impact response. Required when confirmation_required was true." },
          "confirm_responsibility_removal": { "type": "boolean", "enum": [true], "description": "Explicit confirmation required with role_impact_token when the role change removes the last admin/editor role." }
        }
      },
      "RoleImpactRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution_id", "email", "role"],
        "properties": {
          "institution_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "role": { "$ref": "#/components/schemas/RoleType" }
        }
      },
      "InviteUserRequest": {
        "type": "object", "additionalProperties": false, "required": ["institution_id", "name", "email", "role"],
        "properties": {
          "institution_id": { "type": "string", "format": "uuid", "description": "Must equal the authenticated administrator's institution." },
          "name": { "type": "string", "maxLength": 255 },
          "email": { "type": "string", "format": "email", "maxLength": 255 },
          "role": { "type": "string", "enum": ["admin", "editor", "reader"] }
        }
      },
      "InvitationMutationData": {
        "type": "object", "additionalProperties": false, "required": ["user_id", "activation_status", "delivery_status", "expires_at"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "activation_status": { "const": "pending_activation" },
          "delivery_status": { "type": "string", "enum": ["pending", "accepted", "failed"] },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "InvitationStatusData": {
        "type": "object", "additionalProperties": false, "required": ["user_id", "activation_status", "delivery_status", "expires_at", "last_sent_at"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "activation_status": { "type": "string", "enum": ["pending_activation", "activated", "legacy_unverified"] },
          "delivery_status": { "type": ["string", "null"], "enum": ["pending", "accepted", "failed", null] },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "last_sent_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "InvitationMutationSuccess": { "type": "object", "additionalProperties": false, "required": ["success", "data", "message"], "properties": { "success": { "const": true }, "data": { "$ref": "#/components/schemas/InvitationMutationData" }, "message": { "type": "string", "enum": ["Account created and invitation queued.", "Account created, but the invitation could not be queued. It can be resent.", "Invitation queued successfully.", "The invitation could not be queued. It can be resent."] } } },
      "InvitationStatusSuccess": { "type": "object", "additionalProperties": false, "required": ["success", "data", "message"], "properties": { "success": { "const": true }, "data": { "$ref": "#/components/schemas/InvitationStatusData" }, "message": { "const": "Invitation status retrieved successfully." } } },
      "CanonicalError": { "type": "object", "additionalProperties": false, "required": ["success", "error"], "properties": { "success": { "const": false }, "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } },
      "RoleImpactData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["affected_documents_count", "confirmation_required", "impact_token"],
        "properties": {
          "affected_documents_count": { "type": "integer", "minimum": 0 },
          "confirmation_required": { "type": "boolean" },
          "impact_token": { "type": ["string", "null"], "description": "Opaque state-bound token; null when no confirmation is required." }
        }
      },
      "RoleImpactSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "data", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/RoleImpactData" },
          "message": { "type": "string", "enum": ["Role change impact retrieved successfully."] }
        }
      },
      "DeleteUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution_id", "email"],
        "properties": {
          "institution_id": { "type": "string", "format": "uuid", "description": "Must equal the authenticated admin's own institution_id and the target user's institution_id." },
          "email": { "type": "string", "format": "email", "description": "Identifies a user in the authenticated admin's institution and must not identify the authenticated admin. Foreign and nonexistent emails are indistinguishable." }
        }
      },
      "LegacyError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string" }
        }
      },
      "ForbiddenError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "enum": ["Forbidden."] }
        }
      },
      "AnotherAdministratorRequiredError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "error"],
        "properties": {
          "success": { "const": false },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "enum": [
                  "INSTITUTION_SUSPENDED",
                  "AUTH_UNAUTHENTICATED",
                  "AUTH_ACCOUNT_INACTIVE",
                  "USER_QUOTA_EXCEEDED",
                  "INSTITUTION_REQUIRES_USABLE_ADMIN"
                ]
              },
              "message": { "type": "string" },
              "details": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "limit",
                  "used",
                  "requested_delta"
                ],
                "properties": {
                  "role": {
                    "enum": ["admin", "editor", "reader"]
                  },
                  "limit": { "type": "integer", "minimum": 0 },
                  "used": { "type": "integer", "minimum": 0 },
                  "requested_delta": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      },
      "RoleChangeImpactError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "message", "code"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string" },
          "code": { "type": "string", "enum": ["ROLE_CHANGE_IMPACT_CONFIRMATION_REQUIRED", "ROLE_CHANGE_IMPACT_STALE"] }
        }
      },
      "ValidationFailedError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "message", "data"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string", "enum": ["Validation failed."] },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["error"],
            "properties": {
              "error": {
                "type": "object",
                "description": "Laravel validator error bag: field name to list of messages.",
                "additionalProperties": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      },
      "InstitutionAccessError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "error"],
        "properties": {
          "success": { "const": false },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "enum": [
                  "INSTITUTION_SUSPENDED",
                  "AUTH_UNAUTHENTICATED",
                  "AUTH_ACCOUNT_INACTIVE",
                  "USER_QUOTA_EXCEEDED",
                  "INSTITUTION_REQUIRES_USABLE_ADMIN"
                ]
              },
              "message": { "type": "string" },
              "details": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "limit",
                  "used",
                  "requested_delta"
                ],
                "properties": {
                  "role": {
                    "enum": ["admin", "editor", "reader"]
                  },
                  "limit": { "type": "integer", "minimum": 0 },
                  "used": { "type": "integer", "minimum": 0 },
                  "requested_delta": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "A valid Sanctum bearer token is required.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/LegacyError" },
            "example": { "success": false, "message": "Unauthenticated." }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated user does not have users.manage.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ForbiddenError" },
            "example": { "message": "Forbidden." }
          }
        }
      },
      "InstitutionUserNotFound": {
        "description": "The supplied institutional context or target user is unavailable. Foreign and nonexistent targets are indistinguishable.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/LegacyError" },
            "example": { "success": false, "message": "Institution user not found." }
          }
        }
      },
      "AnotherAdministratorRequired": {
        "description": "The mutation would remove the last usable administrator. Inactive or pending administrators do not qualify.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/AnotherAdministratorRequiredError" },
            "example": {
              "success": false,
              "error": {"code": "INSTITUTION_REQUIRES_USABLE_ADMIN", "message": "Institutional access is not available for this operation."}
            }
          }
        }
      },
      "RoleChangeConflict": {
        "description": "Quota/last usable admin, missing responsibility confirmation or stale impact.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/InstitutionAccessError"
                },
                { "$ref": "#/components/schemas/RoleChangeImpactError" }
              ]
            },
            "examples": {
              "confirmationRequired": { "value": { "success": false, "message": "Review and confirm the responsibility impact before changing this role.", "code": "ROLE_CHANGE_IMPACT_CONFIRMATION_REQUIRED" } },
              "stale": { "value": { "success": false, "message": "The responsibility impact has changed. Review it again before confirming.", "code": "ROLE_CHANGE_IMPACT_STALE" } }
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "Request validation failed.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationFailedError" },
            "example": {
              "success": false,
              "message": "Validation failed.",
              "data": { "error": { "email": ["The email field is required."] } }
            }
          }
        }
      }
    }
  }
}
