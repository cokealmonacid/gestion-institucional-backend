{
  "openapi": "3.1.0",
  "info": {
    "title": "Acervo Authentication API",
    "version": "3.0.0",
    "description": "Canonical Bearer-token authentication and user access lifecycle contract for Acervo. Version 2.1 adds invitation activation, non-enumerating password recovery, password reset, and authenticated password change without changing the existing login, profile, or logout operations. Runtime API addresses are supplied by each deployment and are not part of this contract. Block B consistently enforces operational suspension and credential epochs. Old credentials without current epoch metadata require fresh login; reactivation restores no credentials."
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Authenticate a user and issue a Sanctum Bearer token",
        "description": "Returns a Sanctum Personal Access Token in data.token. This contract does not define or issue a refresh token. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSuccess"
                }
              }
            }
          },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/InvalidCredentialsError"
                    },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "oneOf": [
                        { "$ref": "#/components/schemas/InstitutionRequiredError" },
                        { "$ref": "#/components/schemas/AccountInactiveError" }
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/user/profile": {
      "get": {
        "operationId": "profile",
        "summary": "Get the authenticated user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileSuccess"
                }
              }
            }
          },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/UnauthenticatedError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstitutionAccessError"
                }
              }
            }
          }
        },
        "description": " Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish."
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revoke the current Sanctum access token",
        "description": "Revokes only the Bearer token used for this request. Other access tokens issued to the same user remain valid.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutSuccess"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-recovery": {
      "post": {
        "operationId": "requestPasswordRecovery",
        "summary": "Request password recovery without disclosing account state",
        "description": "Always returns the same accepted response for a syntactically valid email. Mail is queued only for an activated, active, non-deleted user in an active institution.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailRequest" } } } },
        "responses": {
          "202": { "description": "Request accepted regardless of account existence or eligibility.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecoveryRequestedSuccess" } } } },
          "422": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/auth/password-reset": {
      "post": {
        "operationId": "resetPassword",
        "summary": "Consume a password recovery token",
        "description": "Requires an activated and enabled account in an active institution. A successful reset revokes every Sanctum token and does not alter email verification or administrative activation.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordTokenRequest" } } } },
        "responses": {
          "200": { "description": "Password reset; the user must sign in again.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetSuccess" } } } },
          "400": { "description": "The link is invalid, expired, consumed, or no longer eligible.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccessLinkError" } } } },
          "422": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/auth/activation": {
      "post": {
        "operationId": "activateInvitedUser",
        "summary": "Activate an invited account and establish its password",
        "description": "Consumes a single-purpose invitation token. Activation verifies the email and sets the password atomically without signing the user in.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordTokenRequest" } } } },
        "responses": {
          "200": { "description": "Account activated; the user must sign in.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivationSuccess" } } } },
          "400": { "description": "The invitation is invalid, expired, consumed, replaced, or no longer eligible.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccessLinkError" } } } },
          "422": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/user/update-password": {
      "patch": {
        "operationId": "updateAuthenticatedPassword",
        "summary": "Change the authenticated user's password",
        "description": "Requires the current password and revokes all Sanctum tokens plus pending password recovery tokens after success. Suspended institutions are denied with INSTITUTION_SUSPENDED (403). Revoked/unstamped credentials are unavailable (401). Reads recheck before emission; admitted streams may finish.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthenticatedPasswordRequest" } } } },
        "responses": {
          "200": { "description": "Password changed; the current token is revoked.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordChangedSuccess" } } } },
          "401": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/UnauthenticatedError" },
                    {
                      "$ref": "#/components/schemas/InstitutionAccessError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Suspension, insufficient permission or unavailable credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstitutionAccessError"
                }
              }
            }
          },
          "422": { "description": "Validation failed or the current password is incorrect.", "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "#/components/schemas/ValidationError" }, { "$ref": "#/components/schemas/CurrentPasswordError" }] } } } },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "EmailRequest": {
        "type": "object", "additionalProperties": false, "required": ["email"],
        "properties": { "email": { "type": "string", "format": "email", "maxLength": 255 } }
      },
      "PasswordTokenRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["email", "token", "password", "password_confirmation"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 255 },
          "token": { "type": "string", "minLength": 1 },
          "password": { "type": "string", "minLength": 8, "maxLength": 72, "description": "At most 72 UTF-8 bytes for bcrypt compatibility." },
          "password_confirmation": { "type": "string", "description": "Must equal password." }
        }
      },
      "AuthenticatedPasswordRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["current_password", "password", "password_confirmation"],
        "properties": {
          "current_password": { "type": "string" },
          "password": { "type": "string", "minLength": 8, "maxLength": 72, "description": "At most 72 UTF-8 bytes and different from current_password." },
          "password_confirmation": { "type": "string", "description": "Must equal password." }
        }
      },
      "RecoveryRequestedSuccess": { "type": "object", "additionalProperties": false, "required": ["success", "data", "message"], "properties": { "success": { "const": true }, "data": { "type": "null" }, "message": { "const": "If the account is eligible, recovery instructions will be sent." } } },
      "PasswordResetSuccess": { "type": "object", "additionalProperties": false, "required": ["success", "data", "message"], "properties": { "success": { "const": true }, "data": { "type": "null" }, "message": { "const": "Password reset successfully. Sign in again." } } },
      "ActivationSuccess": { "type": "object", "additionalProperties": false, "required": ["success", "data", "message"], "properties": { "success": { "const": true }, "data": { "type": "null" }, "message": { "const": "Account activated successfully. Sign in to continue." } } },
      "PasswordChangedSuccess": { "type": "object", "additionalProperties": false, "required": ["success", "data", "message"], "properties": { "success": { "const": true }, "data": { "type": "null" }, "message": { "const": "Password updated successfully. Sign in again." } } },
      "AccessLinkError": { "type": "object", "additionalProperties": false, "required": ["success", "error"], "properties": { "success": { "const": false }, "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "enum": ["PASSWORD_RESET_LINK_INVALID", "ACTIVATION_LINK_INVALID"] }, "message": { "type": "string" } } } } },
      "CurrentPasswordError": { "type": "object", "additionalProperties": false, "required": ["success", "error"], "properties": { "success": { "const": false }, "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "const": "CURRENT_PASSWORD_INVALID" }, "message": { "const": "The current password is incorrect." } } } } },
      "RateLimitError": { "type": "object", "additionalProperties": false, "required": ["success", "error"], "properties": { "success": { "const": false }, "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "const": "AUTH_RATE_LIMITED" }, "message": { "const": "Too many requests. Try again later." } } } } },
      "Institution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "examples": [
          {
            "id": "92cbbb8b-3dce-45f4-ad41-02325b21c56e",
            "name": "Usuario Editor",
            "email": "editor@example.com",
            "institution": {
              "id": "59b1bfc3-d836-49df-b0ea-cc1e95575499",
              "name": "Institución"
            },
            "roles": ["editor"],
            "abilities": [
              "institution.view",
              "documents.manage",
              "versions.manage",
              "tags.manage",
              "documents.tag",
              "comments.manage",
              "traceability.view"
            ]
          }
        ],
        "required": [
          "id",
          "name",
          "email",
          "institution",
          "roles",
          "abilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "institution": {
            "$ref": "#/components/schemas/Institution"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "admin",
                "editor",
                "reader"
              ]
            }
          },
          "abilities": {
            "type": "array",
            "description": "Institutional abilities currently allowed by the backend Gates. Informational UI guidance only; array order has no authorization semantics.",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "institution.view",
                "users.manage",
                "nodes.manage",
                "documents.manage",
                "versions.manage",
                "tags.manage",
                "documents.tag",
                "comments.manage",
                "traceability.view"
              ]
            }
          }
        }
      },
      "LoginData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user",
          "token"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "Sanctum Personal Access Token to send using the Bearer authentication scheme."
          }
        }
      },
      "ProfileData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "LoginSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "message"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/LoginData"
          },
          "message": {
            "const": "Login successful."
          }
        }
      },
      "ProfileSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "message"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/ProfileData"
          },
          "message": {
            "const": "Profile retrieved successfully."
          }
        }
      },
      "LogoutSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "message"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "type": "null"
          },
          "message": {
            "const": "Logout successful."
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "InvalidCredentialsError": {
        "$ref": "#/components/schemas/ErrorResponse",
        "examples": [
          {
            "success": false,
            "error": {
              "code": "AUTH_INVALID_CREDENTIALS",
              "message": "The provided credentials are invalid."
            }
          }
        ]
      },
      "InstitutionRequiredError": {
        "$ref": "#/components/schemas/ErrorResponse",
        "examples": [
          {
            "success": false,
            "error": {
              "code": "AUTH_INSTITUTION_REQUIRED",
              "message": "A valid institution is required to access the application."
            }
          }
        ]
      },
      "AccountInactiveError": {
        "$ref": "#/components/schemas/ErrorResponse",
        "examples": [
          {
            "success": false,
            "error": {
              "code": "AUTH_ACCOUNT_INACTIVE",
              "message": "This account is inactive."
            }
          }
        ]
      },
      "UnauthenticatedError": {
        "$ref": "#/components/schemas/ErrorResponse",
        "examples": [
          {
            "success": false,
            "error": {
              "code": "AUTH_UNAUTHENTICATED",
              "message": "Authentication is required."
            }
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "fields"
            ],
            "properties": {
              "code": {
                "const": "VALIDATION_ERROR"
              },
              "message": {
                "const": "The given data was invalid."
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "InstitutionAccessError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "enum": [
                  "INSTITUTION_SUSPENDED",
                  "AUTH_UNAUTHENTICATED",
                  "AUTH_ACCOUNT_INACTIVE",
                  "USER_QUOTA_EXCEEDED",
                  "INSTITUTION_REQUIRES_USABLE_ADMIN"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "limit",
                  "used",
                  "requested_delta"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "admin",
                      "editor",
                      "reader"
                    ]
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "used": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "requested_delta": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "RateLimited": { "description": "The operation was rate limited.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RateLimitError" } } } }
    }
  }
}
