{
  "openapi": "3.1.0",
  "info": {
    "title": "Acervo Authentication API",
    "version": "3.0.0",
    "description": "Bearer-token authentication and account onboarding for Acervo. Accounts can hold an expiring onboarding token before email verification and institution creation. The server authorizes every institutional operation independently. Runtime addresses and secrets are not part of this contract."
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register", "summary": "Create an unverified onboarding account",
        "description": "Creates an active account with no institution or role and returns a 24-hour onboarding token. Email delivery is disabled in this release; the response never includes a verification link.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } } },
        "responses": { "201": { "description": "Account created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationSuccess" } } } }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login", "summary": "Authenticate a user and issue a Sanctum Bearer token",
        "description": "Returns an onboarding token for an unverified or institutionless account, or a full token for a ready account. No refresh token is issued.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "Login successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginSuccess" } } } }, "401": { "$ref": "#/components/responses/InvalidCredentials" }, "403": { "$ref": "#/components/responses/AccountInactive" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } }
      }
    },
    "/api/v1/auth/email/verification-notification": {
      "post": {
        "operationId": "resendEmailVerification", "summary": "Request email verification delivery",
        "description": "Requires an active Bearer token. Delivery is intentionally disabled in this release; this operation does not send, enqueue, expose, or consume a verification link.",
        "security": [{ "bearerAuth": [] }],
        "responses": { "202": { "description": "Request processed without delivery", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryDisabledSuccess" } } } }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/AccountInactive" }, "429": { "$ref": "#/components/responses/RateLimited" } }
      }
    },
    "/api/v1/auth/email/verify": {
      "post": {
        "operationId": "verifyEmail", "summary": "Verify the authenticated account with a temporary signed link payload",
        "description": "The signed payload is intended for future email delivery and is not exposed by this release. The authenticated account must match the signed account. Repeating a valid verification is safe.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyEmailRequest" } } } },
        "responses": { "200": { "description": "Email verified", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailVerifiedSuccess" } } } }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/EmailVerificationInvalid" }, "429": { "$ref": "#/components/responses/RateLimited" } }
      }
    },
    "/api/v1/auth/forget-password": {
      "post": {
        "operationId": "requestPasswordReset", "summary": "Request password recovery",
        "description": "Creates a broker-managed hashed recovery token without delivering it in this release. It does not verify an email address and the response never exposes the token.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailRequest" } } } },
        "responses": { "202": { "description": "Request processed without delivery", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryDisabledSuccess" } } } }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } }
      }
    },
    "/api/v1/auth/reset-password-confirm": {
      "post": {
        "operationId": "resetPassword", "summary": "Reset a password using a broker token",
        "description": "Revokes existing personal access tokens after success. Password reset does not verify the email address.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" } } } },
        "responses": { "200": { "description": "Password reset", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetSuccess" } } } }, "400": { "$ref": "#/components/responses/PasswordResetInvalid" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } }
      }
    },
    "/api/v1/user/profile": {
      "get": {
        "operationId": "profile", "summary": "Get the authenticated profile and onboarding state", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Profile retrieved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileSuccess" } } } }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/AccountInactive" } }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout", "summary": "Revoke the current Sanctum access token", "description": "Revokes only the Bearer token used for this request, including onboarding tokens.", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Logout successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LogoutSuccess" } } } }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/AccountInactive" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "Sanctum" } },
    "schemas": {
      "LoginRequest": { "type": "object", "additionalProperties": false, "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string" } } },
      "RegisterRequest": { "type": "object", "additionalProperties": false, "required": ["name", "email", "password", "password_confirmation"], "properties": { "name": { "type": "string", "maxLength": 255 }, "email": { "type": "string", "format": "email", "maxLength": 255 }, "password": { "type": "string", "minLength": 8 }, "password_confirmation": { "type": "string" } } },
      "EmailRequest": { "type": "object", "additionalProperties": false, "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } },
      "ResetPasswordRequest": { "type": "object", "additionalProperties": false, "required": ["email", "token", "password", "password_confirmation"], "properties": { "email": { "type": "string", "format": "email" }, "token": { "type": "string", "minLength": 1 }, "password": { "type": "string", "minLength": 8 }, "password_confirmation": { "type": "string" } } },
      "VerifyEmailRequest": { "type": "object", "additionalProperties": false, "required": ["id", "hash", "expires", "signature"], "properties": { "id": { "type": "string", "format": "uuid" }, "hash": { "type": "string", "minLength": 40, "maxLength": 40 }, "expires": { "type": "integer" }, "signature": { "type": "string", "minLength": 64, "maxLength": 64 } } },
      "Institution": { "type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } },
      "User": { "type": "object", "additionalProperties": false, "required": ["id", "name", "email", "email_verified", "institution", "roles", "abilities"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "email_verified": { "type": "boolean" }, "institution": { "anyOf": [{ "$ref": "#/components/schemas/Institution" }, { "type": "null" }] }, "roles": { "type": "array", "items": { "type": "string", "enum": ["admin", "editor", "reader"] } }, "abilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["institution.view", "users.manage", "nodes.manage", "documents.manage", "versions.manage", "tags.manage", "documents.tag", "comments.manage", "traceability.view"] } } } },
      "Onboarding": { "type": "object", "additionalProperties": false, "required": ["state", "next_step"], "properties": { "state": { "type": "string", "enum": ["verify_email", "create_institution", "ready"] }, "next_step": { "type": "string", "enum": ["verify_email", "create_institution", "ready"] } } },
      "SessionData": { "type": "object", "additionalProperties": false, "required": ["user", "token", "onboarding"], "properties": { "user": { "$ref": "#/components/schemas/User" }, "token": { "type": "string", "minLength": 1 }, "onboarding": { "$ref": "#/components/schemas/Onboarding" } } },
      "RegistrationData": { "allOf": [{ "$ref": "#/components/schemas/SessionData" }, { "type": "object", "required": ["delivery_status"], "properties": { "delivery_status": { "const": "disabled" } } }] },
      "ProfileData": { "type": "object", "additionalProperties": false, "required": ["user", "onboarding"], "properties": { "user": { "$ref": "#/components/schemas/User" }, "onboarding": { "$ref": "#/components/schemas/Onboarding" } } },
      "DeliveryDisabledData": { "type": "object", "additionalProperties": false, "required": ["delivery_status"], "properties": { "delivery_status": { "const": "disabled" } } },
      "SuccessEnvelope": { "type": "object", "additionalProperties": false, "required": ["success", "data", "message"], "properties": { "success": { "const": true }, "data": {}, "message": { "type": "string" } } },
      "LoginSuccess": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/SessionData" }, "message": { "const": "Login successful." } } }] },
      "RegistrationSuccess": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/RegistrationData" }, "message": { "const": "Account created. Email delivery is not available." } } }] },
      "ProfileSuccess": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ProfileData" }, "message": { "const": "Profile retrieved successfully." } } }] },
      "DeliveryDisabledSuccess": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/DeliveryDisabledData" }, "message": { "const": "Email delivery is not available." } } }] },
      "EmailVerifiedSuccess": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["email_verified", "onboarding"], "properties": { "email_verified": { "const": true }, "onboarding": { "$ref": "#/components/schemas/Onboarding" } } }, "message": { "const": "Email verified." } } }] },
      "PasswordResetSuccess": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "type": "array", "maxItems": 0 }, "message": { "const": "Password has been reset successfully." } } }] },
      "LogoutSuccess": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "type": "object", "properties": { "data": { "type": "null" }, "message": { "const": "Logout successful." } } }] },
      "ErrorDetail": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } },
      "ErrorResponse": { "type": "object", "additionalProperties": false, "required": ["success", "error"], "properties": { "success": { "const": false }, "error": { "$ref": "#/components/schemas/ErrorDetail" } } },
      "ValidationError": { "type": "object", "additionalProperties": false, "required": ["success", "error"], "properties": { "success": { "const": false }, "error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "fields"], "properties": { "code": { "const": "VALIDATION_ERROR" }, "message": { "const": "The given data was invalid." }, "fields": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } } } } } }
    },
    "responses": {
      "Unauthenticated": { "description": "Authentication is required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "InvalidCredentials": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "AccountInactive": { "description": "Account is inactive", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "EmailVerificationInvalid": { "description": "Verification link is invalid or expired", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "PasswordResetInvalid": { "description": "Password reset token is invalid or expired", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "ValidationError": { "description": "Request validation failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } },
      "RateLimited": { "description": "Too many requests", "headers": { "Retry-After": { "required": true, "schema": { "type": "integer", "minimum": 1 } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    }
  }
}
