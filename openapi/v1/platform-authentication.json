{
  "openapi": "3.1.0",
  "info": {
    "title": "Acervo platform authentication",
    "version": "1.1.0",
    "description": "Implemented block A: separate Bearer operator identity, required TOTP, purpose-bound challenges, recovery and credential revocation. No institution credentials or cookie fallback. No administrative token before MFA."
  },
  "paths": {
    "/api/v1/platform/auth/login": {
      "post": {
        "operationId": "Platformpasswordlogin",
        "summary": "Platform password login",
        "description": "Password alone returns only a five-minute challenge. Five failures per email/IP per minute, twenty per IP. Inactive or unverified operators cannot obtain administrative access.",
        "responses": {
          "202": {
            "description": "Successful Platform password login",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success",
                    "data",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Challenge"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/auth/mfa/enrollment": {
      "post": {
        "operationId": "EnrollplatformTOTP",
        "summary": "Enroll platform TOTP",
        "description": "Only enrollment/reenrollment challenge. Server issuer Acervo, SHA-1, six digits, 30 seconds. Secret response has Cache-Control no-store; never send URI to a remote QR service.",
        "responses": {
          "200": {
            "description": "Successful Enroll platform TOTP",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success",
                    "data",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "provisioning_uri",
                        "manual_secret",
                        "expires_at"
                      ],
                      "properties": {
                        "provisioning_uri": {
                          "type": "string"
                        },
                        "manual_secret": {
                          "type": "string"
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Proof"
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/auth/mfa/confirmation": {
      "post": {
        "operationId": "ConfirmplatformTOTP",
        "summary": "Confirm platform TOTP",
        "description": "Consume enrollment challenge, persist encrypted secret and accepted step, return ten recovery codes once. Does not issue an administrative token. Fresh login required.",
        "responses": {
          "200": {
            "description": "Successful Confirm platform TOTP",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success",
                    "data",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "recovery_codes",
                        "next_step"
                      ],
                      "properties": {
                        "recovery_codes": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 10,
                          "maxItems": 10
                        },
                        "next_step": {
                          "const": "login"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "challenge_id",
                  "challenge_token",
                  "code"
                ],
                "properties": {
                  "challenge_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "challenge_token": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/auth/mfa/challenge": {
      "post": {
        "operationId": "VerifyplatformMFAchallenge",
        "summary": "Verify platform MFA challenge",
        "description": "Exactly one proof. TOTP must be a newer step globally for this operator; current or adjacent steps only. Recovery code is single-use and returns restricted reenrollment after revoking sessions and factors, never an admin token. Challenge expires in five minutes and permits five failed proofs. Token expires after 60 minutes; no refresh token.",
        "responses": {
          "200": {
            "description": "Successful Verify platform MFA challenge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success",
                    "data",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "operator",
                        "token",
                        "expires_at"
                      ],
                      "properties": {
                        "operator": {
                          "$ref": "#/components/schemas/Operator"
                        },
                        "token": {
                          "type": "string"
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Successful Verify platform MFA challenge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success",
                    "data",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Challenge"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Controlled platform error; secrets are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "challenge_id",
                      "challenge_token",
                      "code"
                    ],
                    "properties": {
                      "challenge_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "challenge_token": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "code": {
                        "type": "string",
                        "pattern": "^\\d{6}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "challenge_id",
                      "challenge_token",
                      "recovery_code"
                    ],
                    "properties": {
                      "challenge_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "challenge_token": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "recovery_code": {
                        "type": "string",
                        "maxLength": 64
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
